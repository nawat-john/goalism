# Staging — same shape as .env.example, distinct secrets/DB from prod and local.
# Phase 6 scaffolds this file; no staging infra is provisioned yet (see
# .github/workflows/deploy-staging.yml). Fill in real values in your host's
# secret manager / GitHub Actions environment, never commit them here.
DATABASE_URL="postgresql://<staging-user>:<staging-pass>@<staging-host>:5432/studyplanner_staging?schema=public"

JWT_ACCESS_SECRET="<generate-a-distinct-staging-secret>"
JWT_REFRESH_SECRET="<generate-a-distinct-staging-secret>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3001
CORS_ORIGIN="https://staging.studyplanner.example"

# Optional — leave unset to disable error reporting.
SENTRY_DSN=""
