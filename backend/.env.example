# PostgreSQL connection (matches docker-compose.yml defaults for local dev)
DATABASE_URL="postgresql://dev:dev@localhost:5432/studyplanner?schema=public"

# JWT secrets — generate strong random values per environment
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# HTTP server
PORT=3001
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:3000"

# Optional — leave unset to disable error reporting.
SENTRY_DSN=""
