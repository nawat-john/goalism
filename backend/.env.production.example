# Production env template (design §10.5). These are set in the host's secret
# manager (`fly secrets set ...`) and in GitHub Actions secrets — NEVER committed.
# There is deliberately NO server-side Gemini key: it is the user's, client-side only.

# Managed Postgres (Neon/Supabase). Require TLS.
DATABASE_URL="postgresql://<user>:<pass>@<host>/<db>?sslmode=require"

# Distinct, strong, random secrets per environment (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET="<generate-a-distinct-production-secret>"
JWT_REFRESH_SECRET="<generate-a-distinct-production-secret>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Drives Secure cookies + Sentry environment + the prod CSP (no unsafe-eval).
NODE_ENV="production"
PORT=3001

# Comma-separated allowlist of the deployed frontend origin(s). No trailing slash.
CORS_ORIGIN="https://app.studyplanner.example"

# Refresh-cookie SameSite. Use "none" when the frontend and API are on different
# registrable domains (e.g. *.vercel.app + *.fly.dev) so the cookie is sent on the
# cross-site /auth/refresh call (SameSite=None implies Secure, forced in code).
# Use "lax" (the default) only when they share a registrable domain
# (app.studyplanner.com + api.studyplanner.com).
COOKIE_SAMESITE="none"

# Error reporting — set to enable Sentry, leave unset to disable.
SENTRY_DSN=""
