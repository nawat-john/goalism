# Production env template for the frontend (set in Vercel → Project → Settings →
# Environment Variables, scoped to Production). NEXT_PUBLIC_* values are inlined
# into the client bundle at build time, so they are public by design.

# Base URL of the deployed API, versioned under /api/v1.
NEXT_PUBLIC_API_URL="https://studyplanner-api.fly.dev/api/v1"

# Error reporting — set to enable Sentry on the client, leave unset to disable.
# When set, its origin is automatically added to the CSP connect-src allowlist
# (see frontend/middleware.ts).
NEXT_PUBLIC_SENTRY_DSN=""
